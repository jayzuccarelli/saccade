# saccade config. Copy to .env (gitignored) and fill in — saccade auto-loads it,
# so `python -m saccade` runs with no launcher script. Real env vars override .env.
# Everything ships commented out: a straight copy keeps the stub sensor + print
# speaker, which run with no keys and no camera. Uncomment what you use.
# Note: comments on their own lines only — `KEY=value  # comment` keeps working,
# but a # inside an unquoted value needs quotes.

# --- models ---
# Local (private, free): run `ollama pull gemma3:4b && ollama pull gemma3:12b`
# SACCADE_GLANCE_BACKEND=ollama
# SACCADE_FOCUS_BACKEND=ollama
# Default http://localhost:11434; override if Ollama runs elsewhere:
# SACCADE_OLLAMA_HOST=http://localhost:11434

# Hosted (API key):
# GEMINI_API_KEY=your-key-here
# SACCADE_GLANCE_BACKEND=gemini
# SACCADE_FOCUS_BACKEND=gemini
# Empty = the provider's default per tier (DEFAULT_MODELS in __main__.py):
# SACCADE_GLANCE_MODEL=
# SACCADE_FOCUS_MODEL=

# --- local webcam (Mac/Linux/Windows) — `python -m saccade devices` to list ---
# SACCADE_SENSOR=webcam
# SACCADE_WEBCAM_INDEX=0

# --- screen capture — index 1 = primary; `saccade devices` lists them ---
# SACCADE_SENSOR=screen
# SACCADE_SCREEN_INDEX=1

# --- camera (Reolink over RTSP); saccade assembles + URL-encodes the URL ---
# SACCADE_SENSOR=reolink
# SACCADE_RTSP_USER=admin
# SACCADE_RTSP_PASSWORD=your-camera-password
# SACCADE_RTSP_HOST=192.0.2.217:554
# _sub = low-res (cheap); _main = full-res:
# SACCADE_RTSP_PATH=/h264Preview_01_sub

# --- pacing: capture = frames into the buffer; glance = model calls ---
# SACCADE_CAPTURE_FPS=1.0
# SACCADE_GLANCE_FPS=1.0

# --- voice out: synthesize with Gemini TTS (needs GEMINI_API_KEY) ---
# Play locally — afplay on Mac, aplay on Linux; empty = save wav only:
# SACCADE_SPEAKER=gemini_tts
# SACCADE_PLAY_CMD=afplay
# SACCADE_TTS_VOICE=Kore

# Or play on a Home Assistant media_player (saccade serves the clip itself;
# HA fetches it from http://<serve-host>:<serve-port>, blank host = LAN IP):
# SACCADE_SPEAKER=home_assistant
# SACCADE_HA_ENTITY=media_player.den
# SACCADE_HA_URL=http://localhost:8123
# SACCADE_HA_TOKEN=your-long-lived-token
# SACCADE_SERVE_HOST=
# SACCADE_SERVE_PORT=8189
